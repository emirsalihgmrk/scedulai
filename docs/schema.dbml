enum card_state {
  new
  learning
  review
  relearning
}

enum cefr_level {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum learning_goal {
  work
  travel
  exam
  fun
}

enum level_source {
  self
  placement
}

enum mistake_category {
  tense
  "verb-form"
  agreement
  article
  preposition
  "word-order"
  "word-choice"
  plural
  pronoun
  spelling
  other
}

enum native_language {
  tr
  en
  de
  es
  fr
  it
  ja
  ko
  zh
  ru
  pt
  nl
  pl
  el
  sv
  no
  da
  fi
  ar
}

enum plan {
  free
  premium
}

enum question_direction {
  "native-to-target"
  "target-to-native"
}

enum question_source {
  section
  practice
}

enum question_type {
  translation
}

enum review_rating {
  again
  hard
  good
  easy
}

enum role {
  user
  admin
}

table account {
  id text [pk, not null]
  issuer text [not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at "timestamp with time zone"
  refresh_token_expires_at "timestamp with time zone"
  scope text
  password text
  created_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null]

  indexes {
    user_id [name: 'account_userId_idx']
    (issuer, account_id) [name: 'account_issuer_accountId_unique', unique]
  }
}

table channels {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  youtube_slug text [not null, unique]
  title text [not null]
  thumbnail_url text [not null]
}

table grades {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  question_id uuid
  source question_source [not null]
  is_correct boolean [not null]
  is_first_attempt boolean [not null]

  indexes {
    (user_id, created_at) [name: 'grades_user_id_created_at_idx']
    (user_id, question_id) [name: 'grades_user_id_question_id_idx']
  }
}

table learning_profiles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  level cefr_level
  level_source level_source
  goal learning_goal [not null]
  daily_minutes integer [not null]

  indexes {
    user_id [name: 'learning_profiles_user_unique', unique]
  }
}

table listening_days {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  day date [not null]
  seconds integer [not null, default: 0]

  indexes {
    (user_id, day) [name: 'listening_days_user_day_unique', unique]
  }
}

table mistakes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  question_id uuid
  grade_id uuid
  source question_source [not null]
  category mistake_category [not null]
  incorrect text [not null]
  correction text [not null]
  explanation text [not null]
  source_sentence text [not null]
  user_translation text [not null]

  indexes {
    (user_id, created_at) [name: 'mistakes_user_id_created_at_idx']
    (user_id, category) [name: 'mistakes_user_id_category_idx']
  }
}

table practices {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  category mistake_category [not null]
  completed_at timestamp

  indexes {
    (user_id, created_at) [name: 'practices_user_id_created_at_idx']
  }
}

table programs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  title text [not null]
  slug text [not null, unique]
  description text [not null]
  short_description text [not null]
  channel_id uuid
  thumbnail_url text [not null]
  reference_url text
}

table questions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  quiz_id uuid
  practice_id uuid
  order integer [not null]
  type question_type [not null, default: 'translation']
  direction question_direction [not null, default: 'native-to-target']
  payload jsonb [not null]

  indexes {
    quiz_id [name: 'questions_quiz_id_idx']
    (quiz_id, order) [name: 'questions_quiz_id_order_idx']
    (practice_id, order) [name: 'questions_practice_id_order_idx']
    
  }
}

table quizzes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  section_id uuid [not null]
  native_language native_language [not null]

  indexes {
    section_id [name: 'quizzes_section_id_idx']
    (section_id, native_language) [name: 'quizzes_section_native_language_unique', unique]
  }
}

table section_progress {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  section_id uuid [not null]
  video_position_seconds integer [not null, default: 0]
  quiz_completed_at timestamp

  indexes {
    (user_id, section_id) [name: 'section_progress_user_section_unique', unique]
    user_id [name: 'section_progress_user_id_idx']
  }
}

table sections {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  program_id uuid [not null]
  video_id uuid
  title text [not null]
  order integer [not null]

  indexes {
    (program_id, order) [name: 'sections_program_order_unique', unique]
    program_id [name: 'sections_program_id_idx']
  }
}

table session {
  id text [pk, not null]
  expires_at "timestamp with time zone" [not null]
  token text [not null, unique]
  created_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null]
  ip_address text
  user_agent text
  user_id text [not null]

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

table transcripts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  video_id uuid [not null]
  content jsonb [not null]

  indexes {
    video_id [name: 'transcripts_video_unique', unique]
  }
}

table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null]
  image text
  created_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null]
  plan plan [not null, default: 'free']
  role role [not null, default: 'user']
  native_language native_language [not null, default: 'tr']
  time_zone text
}

table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

table videos {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  channel_id uuid [not null]
  youtube_id text [not null, unique]
  url text [not null, unique]
  title text [not null]
  published_at text [not null]
  duration_seconds integer [not null]
  thumbnail_url text [not null]
  cefr_level cefr_level
}

table vocabulary_cards {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  vocabulary_item_id uuid [not null]
  state card_state [not null]
  due timestamp [not null]
  stability "double precision" [not null]
  difficulty "double precision" [not null]
  scheduled_days integer [not null]
  learning_steps integer [not null]
  reps integer [not null]
  lapses integer [not null]
  last_reviewed_at timestamp [not null]

  indexes {
    vocabulary_item_id [name: 'vocabulary_cards_item_unique', unique]
    (user_id, due) [name: 'vocabulary_cards_user_id_due_idx']
  }
}

table vocabulary_items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  phrase text [not null]
  meaning text [not null]
  context text [not null]
  context_phrase text
  video_id uuid
  time_seconds integer

  indexes {
    (user_id, phrase) [name: 'vocabulary_items_user_phrase_unique', unique]
    (user_id, created_at) [name: 'vocabulary_items_user_id_created_at_idx']
    
  }
}

table vocabulary_reviews {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id text [not null]
  vocabulary_item_id uuid [not null]
  rating review_rating [not null]
  state card_state [not null]

  indexes {
    (user_id, created_at) [name: 'vocabulary_reviews_user_id_created_at_idx']
    vocabulary_item_id [name: 'vocabulary_reviews_item_id_idx']
  }
}

ref: account.user_id > user.id

ref: grades.user_id > user.id

ref: grades.question_id > questions.id

ref: learning_profiles.user_id > user.id

ref: listening_days.user_id > user.id

ref: mistakes.user_id > user.id

ref: mistakes.question_id > questions.id

ref: mistakes.grade_id > grades.id

ref: practices.user_id > user.id

ref: programs.channel_id > channels.id

ref: questions.quiz_id > quizzes.id

ref: questions.practice_id > practices.id

ref: quizzes.section_id > sections.id

ref: section_progress.user_id > user.id

ref: section_progress.section_id > sections.id

ref: sections.program_id > programs.id

ref: sections.video_id - videos.id

ref: session.user_id > user.id

ref: transcripts.video_id > videos.id

ref: videos.channel_id > channels.id

ref: vocabulary_cards.user_id > user.id

ref: vocabulary_cards.vocabulary_item_id - vocabulary_items.id

ref: vocabulary_items.user_id > user.id

ref: vocabulary_items.video_id - videos.id

ref: vocabulary_reviews.user_id > user.id

ref: vocabulary_reviews.vocabulary_item_id > vocabulary_items.id